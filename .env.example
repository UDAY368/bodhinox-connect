# All optional. The site builds and runs with none of them set.
# The website itself is served at https://www.bodhinoxconnect.in (site.url in content/site.ts); the bare domain redirects there.

# Where "Start free" and "Sign in" point. Defaults to https://app.bodhinoxconnect.in
NEXT_PUBLIC_APP_URL=

# Contact form POST endpoint (for example a Formspree URL). When empty the form falls back to mailto:.
NEXT_PUBLIC_CONTACT_ENDPOINT=

# Meta Business Suite domain verification code (the content value only).
NEXT_PUBLIC_FB_DOMAIN_VERIFICATION=

# Google Search Console HTML-tag verification code (the content value only).
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
